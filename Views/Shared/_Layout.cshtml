<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FreelanceOS</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body data-page="app">
    <aside class="sidebar">
        <a class="brand" href="/">
            <strong>FreelanceOS</strong>
        </a>
        <nav class="side-nav" aria-label="Main navigation">
            <button class="nav-link is-active" data-view="dashboard">Dashboard</button>
            <button class="nav-link" data-view="projects">Projects</button>
            <button class="nav-link" data-view="tasks">Tasks</button>
            <button class="nav-link" data-view="contracts">Contracts</button>
            <button class="nav-link" data-view="invoices">Invoices</button>
            <button class="nav-link" data-view="profile">Profile</button>
        </nav>
    </aside>

    <main class="main-shell">
        <header class="topbar">
            <div>
                <p class="eyebrow">Freelancer management</p>
                <h1 id="pageTitle">Dashboard</h1>
            </div>
            <div class="top-actions">
                <button class="ghost-btn" id="refreshBtn" type="button">Refresh</button>
                <div class="user-chip" id="userChip">Loading...</div>
                <button class="danger-link" id="logoutBtn" type="button">Logout</button>
            </div>
        </header>
        @RenderBody()
    </main>

    <div id="modalRoot"></div>
    <div id="toastRoot" class="toast-root"></div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
