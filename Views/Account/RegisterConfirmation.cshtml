@{
    ViewData["Title"] = "Registration Confirmed";
    ViewData["HideNavbar"] = true;
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body text-center p-5">
                    <h4 class="mb-3">Registration Successful</h4>
                    <p class="text-muted mb-4">A confirmation email has been sent to your email address. Please check your inbox and click the confirmation link to activate your account.</p>
                    <a asp-action="Login" class="btn btn-primary">Go to Login</a>
                </div>
            </div>
        </div>
    </div>
</div>
