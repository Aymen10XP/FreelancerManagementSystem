@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}

<section class="auth-card compact">
    <div class="auth-hero">
        <span class="brand-mark large">F</span>
        <p class="eyebrow">Create demo user</p>
        <h1>Join FreelanceOS</h1>
        <p>Create a client or freelancer account and jump into the same workspace flows.</p>
    </div>

    <form class="auth-form" id="registerForm">
        <div class="form-grid two">
            <label>First name
                <input id="firstName" type="text" required />
            </label>
            <label>Last name
                <input id="lastName" type="text" required />
            </label>
        </div>
        <label>Email
            <input id="email" type="email" autocomplete="email" required />
        </label>
        <label>Password
            <input id="password" type="password" autocomplete="new-password" required />
        </label>
        <label>Confirm password
            <input id="confirmPassword" type="password" autocomplete="new-password" required />
        </label>
        <label>Account type
            <select id="role">
                <option value="Freelancer">Freelancer</option>
                <option value="Client">Client</option>
            </select>
        </label>
        <button class="primary-btn" type="submit">Create account</button>
        <p class="form-note">Already registered? <a href="/Account/Login">Sign in</a></p>
    </form>
</section>
