@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}

<section class="auth-card">
    <div class="auth-hero">
        <span class="brand-mark large">F</span>
        <p class="eyebrow">University demo platform</p>
        <h1>FreelanceOS</h1>
        <p>Manage projects, tasks, contracts, invoices, and payments from one clean workspace.</p>
        <div class="demo-grid">
            <button type="button" class="demo-account" data-email="aziz.admin@example.com" data-password="Admin@123">
                <strong>Mohamed Aziz - Admin</strong><span>aziz.admin@example.com</span>
            </button>
            <button type="button" class="demo-account" data-email="aymen.client@example.com" data-password="Client@123">
                <strong>Aymen - Client</strong><span>aymen.client@example.com</span>
            </button>
            <button type="button" class="demo-account" data-email="fadi.freelancer@example.com" data-password="Freelancer@123">
                <strong>Fadi - Freelancer</strong><span>fadi.freelancer@example.com</span>
            </button>
            <button type="button" class="demo-account" data-email="majdi.freelancer@example.com" data-password="Freelancer@123">
                <strong>Majdi - Freelancer</strong><span>majdi.freelancer@example.com</span>
            </button>
        </div>
    </div>

    <form class="auth-form" id="loginForm">
        <div>
            <p class="eyebrow">Welcome back</p>
            <h2>Sign in</h2>
        </div>
        <label>Email
            <input id="email" name="email" type="email" autocomplete="email" required />
        </label>
        <label>Password
            <input id="password" name="password" type="password" autocomplete="current-password" required />
        </label>
        <button class="primary-btn" type="submit">Enter workspace</button>
        <p class="form-note">No account yet? <a href="/Account/Register">Create one</a></p>
    </form>
</section>
