@{
    ViewData["Title"] = "Email Confirmed";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body text-center p-5">
                    <h4 class="mb-3">Email Confirmed</h4>
                    <p class="text-muted mb-4">Thank you for confirming your email. You can now log in.</p>
                    <a asp-action="Login" class="btn btn-success">Sign In</a>
                </div>
            </div>
        </div>
    </div>
</div>