@model FreelancerManagementSystem.Models.Contract

@{
    ViewData["Title"] = "Contract Details";
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="h2 fw-bold text-dark mb-2">
                        <i class="bi bi-file-earmark-text"></i> @Model.Title
                    </h1>
                    <p class="text-muted">Contract Details</p>
                </div>
                <div>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                        <i class="bi bi-pencil"></i> Edit
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                        <i class="bi bi-trash"></i> Delete
                    </a>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Back
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Contract Information</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <small class="text-muted d-block">Status</small>
                            <strong>
                                <span class="badge bg-@(Model.Status == "Signed" ? "success" : Model.Status == "Terminated" ? "danger" : Model.Status == "Sent" ? "warning" : "secondary")">
                                    @Model.Status
                                </span>
                            </strong>
                        </div>
                        <div class="col-md-6">
                            <small class="text-muted d-block">Rate Type</small>
                            <strong>@Model.RateType</strong>
                        </div>
                    </div>

                    <hr />

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <small class="text-muted d-block">Rate</small>
                            <strong>$@Model.Rate.ToString("N2")</strong>
                        </div>
                        <div class="col-md-6">
                            <small class="text-muted d-block">Total Amount</small>
                            <strong>$@Model.TotalAmount.ToString("N2")</strong>
                        </div>
                    </div>

                    <hr />

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <small class="text-muted d-block">Start Date</small>
                            <strong>@Model.StartDate.ToString("MMM dd, yyyy")</strong>
                        </div>
                        <div class="col-md-6">
                            <small class="text-muted d-block">End Date</small>
                            <strong>@Model.EndDate.ToString("MMM dd, yyyy")</strong>
                        </div>
                    </div>

                    <hr />

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <small class="text-muted d-block">Created</small>
                            <strong>@Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</strong>
                        </div>
                        @if (Model.UpdatedAt.HasValue)
                        {
                            <div class="col-md-6">
                                <small class="text-muted d-block">Last Updated</small>
                                <strong>@Model.UpdatedAt.Value.ToString("MMM dd, yyyy HH:mm")</strong>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Description</h5>
                </div>
                <div class="card-body">
                    <p>@Model.Content</p>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Terms))
            {
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Terms & Conditions</h5>
                    </div>
                    <div class="card-body">
                        <p>@Model.Terms</p>
                    </div>
                </div>
            }
        </div>

        <div class="col-lg-4">
            @if (Model.Project != null)
            {
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Related Project</h5>
                    </div>
                    <div class="card-body">
                        <p class="mb-2">
                            <strong>@Model.Project.Name</strong>
                        </p>
                        <small class="text-muted">@Model.Project.Description</small>
                        <div class="mt-3">
                            <a asp-controller="Projects" asp-action="Details" asp-route-id="@Model.Project.Id" class="btn btn-sm btn-outline-primary w-100">
                                <i class="bi bi-eye"></i> View Project
                            </a>
                        </div>
                    </div>
                </div>
            }

            @if (Model.Freelancer != null)
            {
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Freelancer</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="flex-grow-1">
                                <p class="mb-0">
                                    <strong>@Model.Freelancer.FullName</strong>
                                </p>
                                <small class="text-muted">@Model.Freelancer.Email</small>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (Model.Client != null)
            {
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Client</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="flex-grow-1">
                                <p class="mb-0">
                                    <strong>@Model.Client.FullName</strong>
                                </p>
                                <small class="text-muted">@Model.Client.Email</small>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (Model.Invoices != null && Model.Invoices.Any())
            {
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Related Invoices</h5>
                    </div>
                    <div class="card-body">
                        <div class="list-group list-group-flush">
                            @foreach (var invoice in Model.Invoices)
                            {
                                <div class="list-group-item px-0">
                                    <small>Invoice #@invoice.Id.ToString().Substring(0, 8)...Substring(0, 8)</small>
                                    <br />
                                    <strong>$@invoice.Amount.ToString("N2")</strong>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
