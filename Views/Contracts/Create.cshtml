@model FreelancerManagementSystem.Models.Contract

@{
    ViewData["Title"] = "Create Contract";
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="h2 fw-bold text-dark mb-2">
                <i class="bi bi-plus-circle"></i> Create New Contract
            </h1>
            <p class="text-muted">Create a new contract between client and freelancer</p>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Contract Details</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label"></label>
                            <input asp-for="Title" class="form-control" placeholder="e.g., Web Development Services" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Content" class="form-label"></label>
                            <textarea asp-for="Content" class="form-control" rows="4" placeholder="Contract description and details..."></textarea>
                            <span asp-validation-for="Content" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Terms" class="form-label"></label>
                            <textarea asp-for="Terms" class="form-control" rows="3" placeholder="Terms and conditions..."></textarea>
                            <span asp-validation-for="Terms" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="ProjectId" class="form-label">Project</label>
                                <select asp-for="ProjectId" class="form-select" asp-items="@(new SelectList(ViewBag.Projects, "Id", "Name"))">
                                    <option value="">Select a project</option>
                                </select>
                                <span asp-validation-for="ProjectId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="FreelancerId" class="form-label">Freelancer</label>
                                <select asp-for="FreelancerId" class="form-select" asp-items="@(new SelectList(ViewBag.Users, "Id", "FullName"))">
                                    <option value="">Select a freelancer</option>
                                </select>
                                <span asp-validation-for="FreelancerId" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="ClientId" class="form-label">Client</label>
                                <select asp-for="ClientId" class="form-select" asp-items="@(new SelectList(ViewBag.Users, "Id", "FullName"))">
                                    <option value="">Select a client</option>
                                </select>
                                <span asp-validation-for="ClientId" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Rate" class="form-label"></label>
                                <input asp-for="Rate" class="form-control" type="number" step="0.01" placeholder="0.00" />
                                <span asp-validation-for="Rate" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="RateType" class="form-label"></label>
                                <select asp-for="RateType" class="form-select">
                                    <option value="">Select Rate Type</option>
                                    <option value="Hourly">Hourly</option>
                                    <option value="Fixed">Fixed</option>
                                    <option value="Project">Project</option>
                                </select>
                                <span asp-validation-for="RateType" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="TotalAmount" class="form-label"></label>
                            <input asp-for="TotalAmount" class="form-control" type="number" step="0.01" placeholder="0.00" />
                            <span asp-validation-for="TotalAmount" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="StartDate" class="form-label"></label>
                                <input asp-for="StartDate" class="form-control" type="date" />
                                <span asp-validation-for="StartDate" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="EndDate" class="form-label"></label>
                                <input asp-for="EndDate" class="form-control" type="date" />
                                <span asp-validation-for="EndDate" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Status" class="form-label"></label>
                            <select asp-for="Status" class="form-select">
                                <option value="Draft">Draft</option>
                                <option value="Sent">Sent</option>
                                <option value="Signed">Signed</option>
                                <option value="Terminated">Terminated</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle"></i> Create Contract
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
